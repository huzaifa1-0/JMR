# Copy to .env and edit. Everything here can also be changed in the Settings UI,
# which writes to the database and takes precedence over these values.

# --- server ---
JRP_HOST=127.0.0.1
JRP_PORT=8420
JRP_OPEN_BROWSER=true

# --- storage ---
# Defaults to %LOCALAPPDATA%\JobResearch on Windows
# JRP_DATA_DIR=C:\Users\you\Documents\JobResearch

# --- identify yourself honestly to the sources you query ---
JRP_USER_AGENT=JobMarketResearchPlatform/1.0 (research; you@example.com)

# --- source credentials (all free to obtain) ---
# https://developer.adzuna.com
JRP_ADZUNA_APP_ID=
JRP_ADZUNA_APP_KEY=
# https://developer.usajobs.gov
JRP_USAJOBS_API_KEY=
JRP_USAJOBS_EMAIL=

# --- collection behaviour ---
JRP_MAX_RESULTS_PER_RUN=500
JRP_RATE_LIMIT_PER_MINUTE=20
JRP_CACHE_TTL_MINUTES=60
JRP_LOG_LEVEL=INFO
